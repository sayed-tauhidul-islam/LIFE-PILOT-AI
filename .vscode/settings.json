{
    "editor.formatOnSave": false,
    "[blade]": {
        "editor.formatOnSave": false,
        "editor.defaultFormatter": null
    },
    "[html]": {
        "editor.formatOnSave": false
    },
    "files.associations": {
        "*.blade.php": "blade"
    },
    "html.format.enable": false,
    "files.exclude": {
        "**/node_modules": true,
        "**/vendor": true,
        "**/public/build": true,
        "**/storage/framework/cache": true,
        "**/docs/archive": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/vendor": true,
        "**/public/build": true,
        "**/storage/framework/cache": true,
        "**/docs/archive": true
    }
}
